ifneq ($(CONFIG_COMPONENTS_WEATHER),)
ifneq ($(AW_SRCDIR),)

WEATHER_SERVICE_SOURCE_PATH=components/weather_service
WEATHER_SERVICE_INCLUDE_PATH=$(WEATHER_SERVICE_SOURCE_PATH)/include

DEPPATH += --dep-path $(WEATHER_SERVICE_SOURCE_PATH)
VPATH += :chip/$(WEATHER_SERVICE_SOURCE_PATH)

ARCH_WEATHER_SERVICE_PATH := $(AW_SRCDIR)/$(WEATHER_SERVICE_SOURCE_PATH)
ARCH_WEATHER_SERVICE_INCLUDE_PATH := $(AW_SRCDIR)/$(WEATHER_SERVICE_INCLUDE_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_WEATHER_SERVICE_INCLUDE_PATH)

CHIP_CSRCS += $(WEATHER_SERVICE_SOURCE_PATH)/weather_service.c
CHIP_CSRCS += $(WEATHER_SERVICE_SOURCE_PATH)/weather_http.c
CHIP_CSRCS += $(WEATHER_SERVICE_SOURCE_PATH)/weather_json.c

endif
endif
