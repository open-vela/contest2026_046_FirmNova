	bool "AI Agent demo thin app (regression test)"
	default n
	select RIVOTEK_AI_AGENT_LIB
	depends on NET_TCP && NETUTILS_CJSON
	---help---
		Minimal thin app that calls ai_agent_run() with a default
		profile.  Used to verify the library builds and boots.

