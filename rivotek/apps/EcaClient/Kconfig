config ECA_CLIENT_APP
	bool "EcaClient application"
	default n
	depends on GRAPHICS_LVGL
	depends on LV_USE_OBSERVER
	depends on LV_USE_QRCODE
	depends on NET && WIRELESS_WAPI
	depends on LIBC_NETDB
	depends on NET_TCP
	depends on NETUTILS_NTPCLIENT
	select RIVOTEK_COMPONENT_AUDIO
	select RIVOTEK_COMPONENT_TIME
	select RIVOTEK_QRCODE_SERVICE
	select RIVOTEK_PROVISIONING_SERVICE
	---help---
		Enable a 480x272 EcaClient screen implemented with LVGL subjects
		and observers.

if ECA_CLIENT_APP

config ECA_CLIENT_APP_PROGNAME
	string "Program name"
	default "EcaClient"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config ECA_CLIENT_APP_PRIORITY
	int "EcaClient task priority"
	default 100

config ECA_CLIENT_APP_STACKSIZE
	int "EcaClient stack size"
	default 65536

config ECA_CLIENT_VERBOSE_LOG
	bool "Enable verbose EcaClient logs"
	default n
	---help---
		Enable EcaClient info and debug logs for local debugging. Keep this
		disabled in normal builds to avoid frequent telemetry and network
		retry logs.

endif
