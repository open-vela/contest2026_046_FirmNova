#!/usr/bin/env bash

_rtkbuild_find_script()
{
  local cmd="${COMP_WORDS[0]}"
  local script

  if [ "$(basename "$cmd")" = "rtkbuild.sh" ]; then
    script="$cmd"
  else
    script="${COMP_WORDS[1]}"
  fi

  if [ -f "$script" ]; then
    cd "$(dirname "$script")" >/dev/null 2>&1 && pwd
    return
  fi

  if [ -f "./rtkbuild.sh" ]; then
    pwd
  fi
}

_rtkbuild_complete()
{
  local cur script_dir script action_index config_index

  cur="${COMP_WORDS[COMP_CWORD]}"
  script_dir="$(_rtkbuild_find_script)"

  if [ -z "$script_dir" ]; then
    return 0
  fi

  script="${script_dir}/rtkbuild.sh"
  action_index=1
  config_index=2

  if [ "$(basename "${COMP_WORDS[0]}")" = "sh" ] ||
     [ "$(basename "${COMP_WORDS[0]}")" = "bash" ]; then
    action_index=2
    config_index=3
  fi

  if [ "$COMP_CWORD" -eq "$action_index" ]; then
    COMPREPLY=( $(compgen -W "$("$script" __actions)" -- "$cur") )
    return 0
  fi

  if [ "$COMP_CWORD" -eq "$config_index" ]; then
    case "${COMP_WORDS[$action_index]}" in
      clean|build|rebuild|pack|menuconfig)
        COMPREPLY=( $(compgen -W "$("$script" __configs)" -- "$cur") )
        return 0
        ;;
    esac
  fi

  return 0
}

complete -F _rtkbuild_complete rtkbuild.sh
complete -F _rtkbuild_complete ./rtkbuild.sh
complete -F _rtkbuild_complete sh
complete -F _rtkbuild_complete bash
