RIVOTEK_SERVICE_CFLAGS :=

RIVOTEK_SERVICES_DIR ?= $(APPDIR)/../contest2026_046_FirmNova/rivotek/services

ifdef CONFIG_RIVOTEK_COMPONENT_DISPLAY
RIVOTEK_SERVICE_CFLAGS += ${INCDIR_PREFIX}$(RIVOTEK_SERVICES_DIR)/display_service/include
endif

ifdef CONFIG_RIVOTEK_COMPONENT_INPUT
RIVOTEK_SERVICE_CFLAGS += ${INCDIR_PREFIX}$(RIVOTEK_SERVICES_DIR)/input_service/include
endif

ifdef CONFIG_RIVOTEK_COMPONENT_TIME
RIVOTEK_SERVICE_CFLAGS += ${INCDIR_PREFIX}$(RIVOTEK_SERVICES_DIR)/time_service/include
endif

ifdef CONFIG_RIVOTEK_COMPONENT_WEATHER
RIVOTEK_SERVICE_CFLAGS += ${INCDIR_PREFIX}$(RIVOTEK_SERVICES_DIR)/weather_service/include
endif

ifdef CONFIG_RIVOTEK_COMPONENT_AUDIO
RIVOTEK_SERVICE_CFLAGS += ${INCDIR_PREFIX}$(RIVOTEK_SERVICES_DIR)/audio_service/include
endif

RIVOTEK_COMPONENT_CFLAGS += $(RIVOTEK_SERVICE_CFLAGS)

ifneq ($(strip $(CONFIG_RIVOTEK_COMPONENT_DISPLAY)$(CONFIG_RIVOTEK_COMPONENT_INPUT)$(CONFIG_RIVOTEK_COMPONENT_TIME)$(CONFIG_RIVOTEK_COMPONENT_WEATHER)$(CONFIG_RIVOTEK_COMPONENT_AUDIO)),)
CONFIGURED_APPS += $(RIVOTEK_SERVICES_DIR)
CLEANDIRS += $(RIVOTEK_SERVICES_DIR)
endif

include $(wildcard $(RIVOTEK_SERVICES_DIR)/*/Make.defs)

RIVOTEK_CONFIGURED_SERVICES := $(filter $(RIVOTEK_SERVICES_DIR)/%,$(CONFIGURED_APPS))
CLEANDIRS += $(filter-out $(CLEANDIRS),$(RIVOTEK_CONFIGURED_SERVICES))
